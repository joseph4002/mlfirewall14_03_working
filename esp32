//================================
void setup()
{

Serial.begin(115200);

Serial2.begin(115200,SERIAL_8N1,RXD2,TXD2);

client.setInsecure();

// Enable AP + STA
WiFi.mode(WIFI_AP_STA);

// Connect to Internet
Serial.println("Connecting to Internet...");
WiFi.begin(internetSSID,internetPASS);

while(WiFi.status()!=WL_CONNECTED)
{
delay(500);
Serial.print(".");
}

Serial.println("\nInternet Connected");

// Start Firewall Router
WiFi.softAP(ssid,password);

Serial.println("Firewall started");
Serial.print("Router IP: ");
Serial.println(WiFi.softAPIP());

server.on("/",root);

server.on("/normal",normal);
server.on("/dos",dos);
server.on("/scan",portscan);
server.on("/brute",bruteforce);

server.begin();

}


//================================
void loop()
{
server.handleClient();
}
