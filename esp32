//================================
// Read FPGA classification
//================================
void readFPGA()
{

unsigned long start = millis();

while(!Serial2.available())
{
if(millis()-start > 500) return;
}

int r = Serial2.read();

switch(r)
{

case 0:
result = "NORMAL TRAFFIC";
break;

case 1:
result = "DOS ATTACK";
sendTelegram("DOS");
break;

case 2:
result = "PORTSCAN ATTACK";
sendTelegram("PORTSCAN");
break;

case 3:
result = "BRUTEFORCE ATTACK";
sendTelegram("BRUTEFORCE");
break;

default:
result = "UNKNOWN RESULT";

}

}


