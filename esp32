//================================
// Send packet to FPGA
//================================
void sendPacket(
uint8_t proto,
uint8_t state,
uint16_t dur,
uint16_t sbytes,
uint16_t dbytes,
uint16_t spkts,
uint16_t dpkts)
{

while(Serial2.available()) Serial2.read();

Serial2.write(proto);
Serial2.write(state);

Serial2.write(dur >> 8);
Serial2.write(dur);

Serial2.write(sbytes >> 8);
Serial2.write(sbytes);

Serial2.write(dbytes >> 8);
Serial2.write(dbytes);

Serial2.write(spkts >> 8);
Serial2.write(spkts);

Serial2.write(dpkts >> 8);
Serial2.write(dpkts);

}


//================================
// Get attacker MAC address
//================================
String getAttackerMAC()
{

wifi_sta_list_t wifi_sta_list;
tcpip_adapter_sta_list_t adapter_sta_list;

esp_wifi_ap_get_sta_list(&wifi_sta_list);
tcpip_adapter_get_sta_list(&wifi_sta_list,&adapter_sta_list);

for(int i=0;i<adapter_sta_list.num;i++)
{

tcpip_adapter_sta_info_t station = adapter_sta_list.sta[i];

IPAddress clientIP = IPAddress(station.ip.addr);

if(clientIP == attackerIP)
{

char macStr[18];

sprintf(macStr,"%02X:%02X:%02X:%02X:%02X:%02X",
station.mac[0],
station.mac[1],
station.mac[2],
station.mac[3],
station.mac[4],
station.mac[5]);

return String(macStr);

}

}

return "Unknown";

}


