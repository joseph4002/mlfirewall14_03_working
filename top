`timescale 1ns / 1ps

module firewall_top(

input clk,
input rx,

output tx,

output reg led_rx = 0,
output reg led_normal = 0,
output reg led_attack = 0

);


// UART RX wires
wire [7:0] rx_data;
wire valid;


// feature registers
reg [15:0] dbytes = 0;
reg [15:0] sbytes = 0;
reg [15:0] dur = 0;
reg [7:0] proto = 0;
reg [7:0] state = 0;
reg [15:0] spkts = 0;
reg [15:0] dpkts = 0;


// attack result
wire [2:0] attack;


// UART TX control
reg send = 0;
wire busy;


// byte counter
reg [3:0] byte_count = 0;



// ==============================
// UART RECEIVER
// ==============================
uart_rx RX(

.clk(clk),
.rx(rx),
.data_out(rx_data),
.data_valid(valid)

);



// ==============================
// PACKET LOADER
// ==============================
always @(posedge clk)
begin

send <= 0;

if(valid)
begin

// blink RX LED
led_rx <= ~led_rx;

case(byte_count)

0: proto <= rx_data;

1: state <= rx_data;

2: dur[15:8] <= rx_data;
3: dur[7:0]  <= rx_data;

4: sbytes[15:8] <= rx_data;
5: sbytes[7:0]  <= rx_data;

6: dbytes[15:8] <= rx_data;
7: dbytes[7:0]  <= rx_data;

8: spkts[15:8] <= rx_data;
9: spkts[7:0]  <= rx_data;

10: dpkts[15:8] <= rx_data;

11:
begin

dpkts[7:0] <= rx_data;

send <= 1;


// update LEDs
if(attack == 0)
begin
led_normal <= 1;
led_attack <= 0;
end
else
begin
led_normal <= 0;
led_attack <= 1;
end

end

endcase


// increment byte counter
if(byte_count < 11)
byte_count <= byte_count + 1;
else
byte_count <= 0;

end

end



// ==============================
// DECISION TREE FIREWALL
// ==============================
dt_firewall FIREWALL(

.dbytes(dbytes),
.sbytes(sbytes),
.dur(dur),
.proto(proto),
.state(state),
.spkts(spkts),
.dpkts(dpkts),
.attack(attack)

);



// ==============================
// UART TRANSMITTER
// ==============================
uart_tx TX(

.clk(clk),
.send(send),
.data_in({5'b00000,attack}),
.tx(tx),
.busy(busy)

);


endmodule
